  "sources": {
    "original": "#include <stdio.h>\nint main(void)\n{\n  int a;\n  int b;\n  int c;\n  int d;\n  scanf(\"%d\", &a);\n  scanf(\"%d\", &b);\n  scanf(\"%d\", &c);\n  scanf(\"%d\", &d);\n  int smallest;\n  smallest = a;\n  if (a > b)\n    smallest = b;\n  if (b > c)\n    smallest = c;\n  if (c > d)\n    smallest = d;\n  else\n    if (a > d)\n    smallest = d;\n  printf(\"%d\\n\", smallest);\n  return 0;\n}\n\n",
    "candidate": "#include <stdio.h>\nint main(void)\n{\n  int a;\n  int b;\n  int c;\n  int d;\n  scanf(\"%d\", &a);\n  scanf(\"%d\", &b);\n  scanf(\"%d\", &c);\n  scanf(\"%d\", &d);\n  int smallest;\n  smallest = a;\n  if (a > b)\n    smallest = b;\n  if (b > c)\n    smallest = c;\n  if (d < d)\n    smallest = b;\n  else\n    if (a > d)\n    smallest = d;\n  printf(\"%d\\n\", smallest);\n  return 0;\n}\n\n",
    "reference": "#include <stdio.h>\nint main(void)\n{\n  int num1;\n  int num2;\n  int num3;\n  int num4;\n  int bigger;\n  int bigger2;\n  int biggest;\n  scanf(\"%d%d%d%d\", &num1, &num2, &num3, &num4);\n  if (num1 < num2)\n    bigger = num1;\n  else\n    bigger = num2;\n  if (num4 < num3)\n    bigger2 = num4;\n  else\n    bigger2 = num3;\n  if (bigger < bigger2)\n    biggest = bigger;\n  else\n    biggest = bigger2;\n  printf(\"%d\\n\", biggest);\n  return 0;\n}\n\n"
  }
